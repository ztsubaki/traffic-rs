{
  "openapi": "3.1.0",
  "info": {"title": "traffic-rs API", "version": "v1", "description": "JSON API for inspecting and running a traffic simulation. `/simulation/run` is the sole Server-Sent Events endpoint."},
  "servers": [{"url": "/api/v1"}],
  "paths": {
    "/health": {"get": {"operationId": "getHealth", "responses": {"200": {"description": "Service and host health."}}}},
    "/simulation": {"get": {"operationId": "getSimulation", "responses": {"200": {"description": "Simulation configuration, progress, and global SUMO evaluation metrics including time loss and waiting time."}, "409": {"$ref": "#/components/responses/Conflict"}}}},
    "/simulation/run": {"get": {"operationId": "runSimulation", "parameters": [{"name": "steps", "in": "query", "schema": {"type": "integer", "minimum": 1, "default": 1}}], "responses": {"200": {"description": "SSE stream with `accepted`, `completed`, or `failed` events.", "content": {"text/event-stream": {"schema": {"type": "string"}}}}, "400": {"$ref": "#/components/responses/BadRequest"}}}},
    "/network/statistics": {"get": {"operationId": "getNetworkStatistics", "responses": {"200": {"description": "Network resource counts."}}}},
    "/traffic-lights": {"get": {"operationId": "listTrafficLights", "responses": {"200": {"description": "All traffic lights. Each entry contains resourceId and resource."}}}},
    "/traffic-lights/states": {"get": {"operationId": "listTrafficLightStates", "responses": {"200": {"description": "Current state for every traffic light. Each entry contains resourceId and state."}, "409": {"$ref": "#/components/responses/Conflict"}, "500": {"$ref": "#/components/responses/InternalServerError"}}}},
    "/edges": {"get": {"operationId": "listEdges", "responses": {"200": {"description": "All edges. Each entry contains resourceId and resource."}}}},
    "/lanes": {"get": {"operationId": "listLanes", "responses": {"200": {"description": "All lanes. Each entry contains resourceId and resource."}}}},
    "/junctions": {"get": {"operationId": "listJunctions", "responses": {"200": {"description": "All junctions. Each entry contains resourceId and resource."}}}},
    "/vehicles": {"get": {"operationId": "listVehicles", "responses": {"200": {"description": "All vehicles. Each entry contains resourceId and resource."}, "409": {"$ref": "#/components/responses/Conflict"}}}},
    "/traffic-lights/{id}": {"get": {"operationId": "getTrafficLight", "parameters": [{"$ref": "#/components/parameters/ResourceId"}], "responses": {"200": {"description": "Traffic light."}, "400": {"$ref": "#/components/responses/BadRequest"}, "404": {"$ref": "#/components/responses/NotFound"}}}},
    "/traffic-lights/{id}/state": {"get": {"operationId": "getTrafficLightState", "parameters": [{"$ref": "#/components/parameters/ResourceId"}], "responses": {"200": {"description": "Current traffic light signal and controlled-link traffic metrics. Link pressure is incoming queue count minus outgoing queue count.", "content": {"application/json": {"schema": {"type": "object", "required": ["signals", "links"], "properties": {"signals": {"type": "string", "description": "SUMO red-yellow-green signal state."}, "links": {"type": "array", "description": "Metrics grouped by SUMO controlled-link index."}}}}}}, "400": {"$ref": "#/components/responses/BadRequest"}, "404": {"$ref": "#/components/responses/NotFound"}, "409": {"$ref": "#/components/responses/Conflict"}}}},
    "/edges/{id}": {"get": {"operationId": "getEdge", "parameters": [{"$ref": "#/components/parameters/ResourceId"}], "responses": {"200": {"description": "Edge."}, "400": {"$ref": "#/components/responses/BadRequest"}, "404": {"$ref": "#/components/responses/NotFound"}}}},
    "/lanes/{id}": {"get": {"operationId": "getLane", "parameters": [{"$ref": "#/components/parameters/ResourceId"}], "responses": {"200": {"description": "Lane."}, "400": {"$ref": "#/components/responses/BadRequest"}, "404": {"$ref": "#/components/responses/NotFound"}}}},
    "/junctions/{id}": {"get": {"operationId": "getJunction", "parameters": [{"$ref": "#/components/parameters/ResourceId"}], "responses": {"200": {"description": "Junction."}, "400": {"$ref": "#/components/responses/BadRequest"}, "404": {"$ref": "#/components/responses/NotFound"}}}},
    "/vehicles/{id}": {"get": {"operationId": "getVehicle", "parameters": [{"$ref": "#/components/parameters/ResourceId"}], "responses": {"200": {"description": "Vehicle."}, "400": {"$ref": "#/components/responses/BadRequest"}, "404": {"$ref": "#/components/responses/NotFound"}, "409": {"$ref": "#/components/responses/Conflict"}}}}
  },
  "components": {"parameters": {"ResourceId": {"name": "id", "in": "path", "required": true, "schema": {"type": "integer", "minimum": 0}}}, "responses": {"BadRequest": {"description": "Invalid request.", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/ProblemDetails"}}}}, "NotFound": {"description": "Resource not found.", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/ProblemDetails"}}}}, "Conflict": {"description": "Resource temporarily unavailable.", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/ProblemDetails"}}}}, "InternalServerError": {"description": "The requested resource data could not be produced.", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/ProblemDetails"}}}}}, "schemas": {"ProblemDetails": {"type": "object", "required": ["type", "title", "status", "detail"], "properties": {"type": {"type": "string", "format": "uri-reference"}, "title": {"type": "string"}, "status": {"type": "integer"}, "detail": {"type": "string"}}}}}
}
